// Windows resources: version block. The window icon is drawn at runtime
// (see setWindowIcon in src/main.cpp), so no .ico is needed here.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "davedown markdown editor"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "davedown"
            VALUE "OriginalFilename", "davedown.exe"
            VALUE "ProductName", "davedown"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
